// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model EventConfig {
  id          Int    @id @default(1)
  slotMinutes Int    @default(10) // 1枠の長さ(分)
  eventDates  String @default("") // "2026-09-12,2026-09-13" のようなCSV
  openTime    String @default("09:00")
  closeTime   String @default("17:00")
}

model Rig {
  id           String        @id @default(cuid())
  name         String // 例: "1号機"
  spec         String // スペック説明（自由記述）
  isActive     Boolean       @default(true) // false=当面使わない
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Slot {
  id           String        @id @default(cuid())
  date         String // "2026-09-12"
  startTime    DateTime
  endTime      DateTime
  isOpen       Boolean       @default(true) // 休憩時間等で運営が枠を閉じられる
  reservations Reservation[]

  @@index([date])
}

model Reservation {
  id          String    @id @default(cuid())
  code        String    @unique // 受付/照会用の短い英数字コード
  slotId      String
  slot        Slot      @relation(fields: [slotId], references: [id])
  rigId       String
  rig         Rig       @relation(fields: [rigId], references: [id])
  name        String
  grade       String? // 学年・組（任意）
  status      String    @default("confirmed") // confirmed / cancelled / checked_in
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([slotId])
  @@index([rigId])
}

model Announcement {
  id          String   @id @default(cuid())
  body        String // お知らせ本文（改行可）
  level       String   @default("info") // info=通常 / important=重要
  isPublished Boolean  @default(true) // false=非表示（下書き）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
